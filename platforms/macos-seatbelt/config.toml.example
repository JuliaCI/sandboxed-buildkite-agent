# A Mac runs one job at a time, from both the `build` and `test` queues,
# oldest first; each job gets the whole host and JULIA_CPU_THREADS=total_cpus,
# whatever `sched_*` tags its step sets.
[scheduler]
logdir="@scratch/macos-seatbelt-logs"
# How wide jobs run: a per-host tuning fact, defaulting to all logical cores.
# The M2 Macs ran at 4, which was Julia 1.10's count of their performance cores.
total_cpus=8

[macos]
tempdir="/private/var/tmp"
