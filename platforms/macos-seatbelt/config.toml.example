# A Mac runs jobs from both the `build` and `test` queues, oldest first. A job
# whose step sets no `sched_*` tags gets the whole host, `total_cpus` CPUs and
# `total_mem_gib` GiB (exported as SBA_CPUS_LIMIT and SBA_MEM_GIB), and runs
# alone; jobs of tagged steps get their request and share the host.
# `total_cpus` and `total_mem_gib` default to every core (efficiency cores
# included) and physical memory minus a sixth for macOS.
[scheduler]
logdir="@scratch/macos-seatbelt-logs"

[macos]
tempdir="/private/var/tmp"
