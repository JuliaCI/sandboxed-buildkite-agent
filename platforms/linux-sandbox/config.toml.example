# Each group serves its queues (by default `build` and `test`, one Buildkite
# stack per queue) from one pool of slots. Pipeline steps size their jobs with
# the `sched_cpus`, `sched_cpus_limit`, `sched_mem_gib` and `sched_mem_limit_gib`
# agent tags; steps without them get the group's `default` for their queue. Jobs
# are admitted oldest first while the sums of their CPU and memory requests fit
# `total_cpus` and `total_mem_gib`.
[scheduler]
logdir="@scratch/linux-sandbox-logs"
total_cpus=64
# Memory for jobs: physical memory minus what the OS and caches need.
total_mem_gib=240
# Admit nothing while the host's MemAvailable is below this.
min_mem_available_gib=16
# Evict idle cache pools above 85% use, down to 75%.
disk_high_water_percent=85
disk_low_water_percent=75

[linux]
# Slots are persistent worker identities with their own caches; they bound
# disk use, not concurrency.
max_slots=16

# If you want agents to be able to share a cache directory, you can
# add it here.  Use `@scratch/` to place inside of a scratchspace,
# otherwise use an absolute path.
sharedcache="@scratch/linux_group"

# Where the jobs' writable overlay layers go, if not next to `cachedir`; pick a
# disk with room for what builds write outside `/cache` and `/tmp`.
#persistence_dir="/data/persistence"

# We can add arbitrary tags here
# Sizes of untagged jobs, per queue; each table is a complete size.
[linux.default.build]
cpus=4
cpus_limit=16
mem_gib=40

[linux.default.test]
cpus=12
mem_gib=64

[linux.tags]
sandbox_capable="true"
foo="bar"

[launcher]
queues="launch"
max_slots=4
priority=0

# Pipeline upload steps carry no size tags.
[launcher.default]
cpus=1

[launcher.tags]
sandbox_capable="true"
