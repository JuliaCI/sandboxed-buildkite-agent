# Each group serves its queues (by default `build` and `test`, one Buildkite
# stack per queue) from one pool of slots. Pipeline steps size their jobs with
# the `sched_cpus`, `sched_threads` and `sched_mem_gib` agent tags; steps
# without them get the group's `default` for their queue. Jobs are admitted
# oldest first while the sum of their CPUs fits `total_cpus`.
[scheduler]
logdir="@scratch/linux-sandbox-logs"
total_cpus=64
# Admit nothing while the host's MemAvailable is below this.
min_mem_available_gib=16

[linux]
# Slots are persistent worker identities with their own caches; they bound
# disk use, not concurrency.
max_slots=16

# If you want agents to be able to share a cache directory, you can
# add it here.  Use `@scratch/` to place inside of a scratchspace,
# otherwise use an absolute path.
sharedcache="@scratch/linux_group"

# We can add arbitrary tags here
# Sizes of untagged jobs, per queue; each table is a complete size.
[linux.default.build]
cpus=4
threads=16
mem_gib=40

[linux.default.test]
cpus=12
mem_gib=64

[linux.tags]
sandbox_capable="true"
foo="bar"

[launcher]
queues="launch"
max_slots=4
priority=0

# Pipeline upload steps carry no size tags.
[launcher.default]
cpus=1

[launcher.tags]
sandbox_capable="true"


# Worker groups can also get a rootless docker instance started, one for
# each buildkite agent instance, cleared out after each run.
[docker-enabled]
queues="test"
start_rootless_docker=true
max_slots=2

[docker-enabled.default]
cpus=8

[docker-enabled.tags]
docker_capable="true"
sandbox_capable="true"
