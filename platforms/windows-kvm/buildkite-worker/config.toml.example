# One group serves the `build` and `test` queues (one Buildkite stack per
# queue) from one pool of slots, each slot a VM name and persistent cache disk.
[scheduler]
logdir="@scratch/windows-kvm-logs"
total_cpus=24
# Guests reserve their RAM plus host overhead (30%, at least 8 GiB) from this.
total_mem_gib=128

[windows]
backend="kvm"
guest="windows"
# VM shape bounds for tagged steps: host and image facts, not policy.
max_threads=6
max_mem_gib=32
# Each slot keeps a cache disk (up to 100 GB) under `cachedir`; this bounds disk use.
max_slots=8

# `cachedir` holds the per-job cache disks (qcow2 overlays, partitioned by
# pipeline and trust); the throwaway OS-disk overlays and VM XML live under
# `tempdir`.  Both default to a Scratch.jl scratchspace / the system temp dir;
# point them at disks that can handle the VMs' write load.  On AppArmor hosts,
# grant libvirt-qemu access to non-default locations by adding `<cachedir>/** rk,`
# and `<tempdir>/** rk,` to /etc/apparmor.d/local/abstractions/libvirt-qemu.
#cachedir="/data/agent_build"
#tempdir="/data/agent_tmp"

[windows.tags]
# Manually override this to say `windows`, even though we're on a linux host
os="windows"

